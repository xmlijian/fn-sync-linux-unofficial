{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "飞牛同步",
  "version": "0.2.3",
  "identifier": "com.fn-sync-client.app",
  "build": {
    "frontendDist": "../official-ui"
  },
  "app": {
    "windows": [
      {
        "title": "飞牛同步",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "category": "Utility"
  }
}